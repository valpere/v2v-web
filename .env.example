# Where the engine's end-user /v1 API listens (v2v-demo: WEB_ADDR, docs/web-api.md).
ENGINE_URL=http://127.0.0.1:8091

# Shared secret of the trusted-frontend scheme (engine: WEB_TRUSTED_KEY, >= 32 chars,
# loopback WEB_ADDR). Empty = forward as is, for an engine run with WEB_DEV_AUTH=1:
# every browser then shares ONE principal — local development only.
ENGINE_KEY=

# Listen address and static-files directory.
ADDR=127.0.0.1:8086
WEB_DIR=web

# 1 = take the client address from X-Forwarded-For (rightmost entry). Set it only
# behind a reverse proxy you control; otherwise a client can forge its address.
TRUST_PROXY=

# The site's own origin, e.g. https://demo.example (no path). CSRF checks compare the
# Origin header against it exactly (scheme, host, port) and HSTS is sent when it is https.
# Required behind a reverse proxy that rewrites Host; empty = compare with the Host header.
PUBLIC_ORIGIN=
